# Build outputs and local artifacts
frontend/node_modules/
# Playwright's outputDir (frontend/playwright.config.mjs): run state, never
# source.
frontend/test-results/
# A `python3 -m unittest ...` that omits the documented -B leaves bytecode
# here for a later lane to clean by hand.
__pycache__/
internal/web/dist/*
!internal/web/dist/.gitkeep
# A hand-run `go test -coverprofile=...` from the repo root. CI writes every
# profile to RUNNER_TEMP instead, so nothing in the gate produces these — but
# a generated profile that reaches history cannot be withdrawn.
coverage.out
*.cover.out
.DS_Store

# Agent worktrees (see AGENTS.md, "Parallel agents in one checkout").
.claude/worktrees/
