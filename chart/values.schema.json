{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["replicaCount", "deploymentReady", "image", "service", "ingress", "resources"],
  "definitions": {
    "cpuQuantity": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]*m|[1-9][0-9]*(?:\\.[0-9]{1,3})?|0\\.(?:[1-9][0-9]{0,2}|0[1-9][0-9]?|00[1-9]))$"
    },
    "memoryQuantity": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(?:Ki|Mi|Gi|Ti|Pi|Ei|k|K|M|G|T|P|E)?$"
    },
    "resourcePair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": {"$ref": "#/definitions/cpuQuantity"},
        "memory": {"$ref": "#/definitions/memoryQuantity"}
      }
    }
  },
  "properties": {
    "replicaCount": {"type": "integer", "const": 2},
    "deploymentReady": {"type": "boolean"},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "const": "ghcr.io/snaraj/lidersea-com"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["IfNotPresent", "Never"]}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {"port": {"type": "integer", "const": 8080}}
    },
    "ingress": {
      "type": "object",
      "description": "The deployment-provider binding point: identifies the only ingress peer allowed to reach the origin. The origin itself is provider-neutral and speaks standard HTTP; swapping edge providers is a values override here, never a template or code edit.",
      "additionalProperties": false,
      "required": ["peerNamespace", "peerAppName"],
      "properties": {
        "peerNamespace": {
          "type": "string",
          "description": "Namespace of the ingress connector's pods (DNS-1123 label).",
          "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "peerAppName": {
          "type": "string",
          "description": "app.kubernetes.io/name label of the ingress connector's pods.",
          "pattern": "^[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {"$ref": "#/definitions/resourcePair"},
        "limits": {"$ref": "#/definitions/resourcePair"}
      }
    }
  }
}
